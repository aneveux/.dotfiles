[user]
	name = Antoine Neveux
	email = {{ .email }}
	signingkey = ~/.ssh/id_ed25519

[gpg]
	format = ssh

[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

[include]
	path = ~/catppuccin.gitconfig
	# `git maintenance register --config-file` target, kept out of this managed file
	path = ~/.config/git/maintenance.gitconfig

[commit]
	template = ~/.gitmessage
	gpgsign = true
	verbose = true

[init]
	defaultBranch = master

[push]
	followTags = true
	default = current
	autoSetupRemote = true

[pull]
	rebase = true

[fetch]
	prune = true
	all = true

[transfer]
	fsckobjects = true

[merge]
	tool = nvimdiff
	conflictstyle = zdiff3

[rebase]
	autostash = true
	autosquash = true
	updateRefs = true

[rerere]
	enabled = true
	autoupdate = true

[maintenance]
	auto = true

[column]
	ui = auto

[blame]
	coloring = repeatedLines
	ignoreRevsFile = :(optional).git-blame-ignore-revs

[branch]
	sort = -committerdate

[tag]
	sort = version:refname

[help]
	autocorrect = prompt

[diff]
	algorithm = histogram
	renames = copies
	wordRegex = [A-Za-z0-9]+|[^[:space:]]
	colorMoved = default
	colorMovedWS = allow-indentation-change

[log]
	date = format:%a %b %-d %Y @ %-I:%M %p
	decorate = yes

[core]
	excludesfile = ~/.gitignore
	attributesFile = ~/.gitattributes
	editor = nvim
	filemode = true
	trustctime = false
	autocrlf = input
	pager = delta
	untrackedCache = true

# Config-based hooks (git 2.54+) run before the repo's own .git/hooks entry,
# so repo-local hooks (git-secrets, pre-commit) keep working.
[hook "jira-ticket"]
	event = prepare-commit-msg
	command = ~/.githooks/prepare-commit-msg

[interactive]
	diffFilter = delta --color-only

[advice]
	commitBeforeMerge = false
	detachedHead = false
	pushUpdateRejected = false
	statusHints = false

[color "diff"]
	meta = blue
	frag = magenta bold
	commit = blue bold
	old = red bold
	new = green bold
	whitespace = red reverse

[color "status"]
	added = green reverse
	changed = brightblue reverse
	untracked = red reverse

[mergetool]
	keeptemporaries = false
	keepBackup = false
	prompt = false

[alias]
	# Basic
	addp = add -p
	co = checkout
	ci = commit
	ca = commit -a
	cm = commit -m
	cam = commit -am
	amend = commit --amend
	st = status -sb
	br = branch
	unstage = restore --staged
	garbage = gc --prune=now
	surr = submodule update --recursive --remote
	sclone = clone --depth=1
	cleanall = !git clean -f -x -d && git submodule foreach --recursive git clean -f -x -d

	# Logs
	lg = log --graph --pretty=custom
	lga = log --graph --pretty=custom --all
	ll = log --stat --abbrev-commit
	lc = shortlog --summary --numbered

	# Remote
	fo = fetch origin
	fu = fetch upstream
	po = push origin
	lo = pull origin
	mo = merge --no-ff @{u}
	uo = merge --ff-only @{u}

	# Review
	rdiff = "!f() { git diff \"$1...$2\"; }; f"
	rlog = "!f() { git log \"$1..$2\" --no-merges --format='%h | %an | %ad | %s' --date=local; }; f"

	# Difftastic (structural diff), per the difftastic manual
	dlog = -c diff.external=difft log --ext-diff
	dshow = -c diff.external=difft show --ext-diff
	ddiff = -c diff.external=difft diff

	# Tools
	head = rev-list --max-count=1 HEAD
	pack = !git archive HEAD --format=tar | gzip > ./$(git rev-parse --short HEAD).tar.gz
	ignore = "!f() { printf '%s\\n' \"$@\" >> .gitignore; }; f"
	last = log -1 --stat
	cp = cherry-pick
	cl = clone --recurse-submodules
	dc = diff --cached

	# LOL
	dad = !curl https://icanhazdadjoke.com/ && git add

[pretty]
	custom = "%C(magenta)%h%C(red)%d %C(brightblue)%ar %C(green)%s %C(brightblue)(%an)"
	#                     ¦        ¦            ¦            ¦             +- author name
	#                     ¦        ¦            ¦            +- message
	#                     ¦        ¦            +- date (relative)
	#                     ¦        +- decorations (branch, heads or tags)
	#                     +- hash (abbreviated)

[url "git@github.com:"]
	insteadOf = gh:
	pushInsteadOf = github:
	pushInsteadOf = git://github.com/

[url "https://github.com/"]
	insteadOf = github:

[url "git@gist.github.com:"]
	insteadOf = gst:
	pushInsteadOf = gist:
	pushInsteadOf = git://gist.github.com/

# cargo does not like this
# [url "git@github.com:"]
# 	insteadOf = "https://github.com/"
# 	pushInsteadOf = "https://github.com/"

[delta]
	true-color = always
	navigate = true
	line-numbers = true
	hyperlinks = true
	hyperlinks-file-link-format = "file://{path}"
	# side-by-side as a feature so lazygit can drop it by overriding --features
	features = catppuccin-mocha side-by-side

{{ if eq .machine "flower" }}
[secrets]
	providers = opscore security run git-secrets-provider -q
{{ end }}

# Personal email in my own repos. hasconfig matches the raw remote URL, so each
# spelling (including the gh: shorthand) needs its own pattern.
[includeIf "hasconfig:remote.*.url:git@github.com:aneveux/**"]
	path = ~/.config/git/personal.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/aneveux/**"]
	path = ~/.config/git/personal.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/aneveux/**"]
	path = ~/.config/git/personal.gitconfig
[includeIf "hasconfig:remote.*.url:gh:aneveux/**"]
	path = ~/.config/git/personal.gitconfig

# hasconfig matches if ANY remote matches: work repos with an aneveux fork remote
# would get the personal email, so restore the machine email for them (last wins).
[includeIf "hasconfig:remote.*.url:git@github.com:cloudbees/**"]
	path = ~/.config/git/machine.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/cloudbees/**"]
	path = ~/.config/git/machine.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/cloudbees/**"]
	path = ~/.config/git/machine.gitconfig
[includeIf "hasconfig:remote.*.url:gh:cloudbees/**"]
	path = ~/.config/git/machine.gitconfig
[includeIf "hasconfig:remote.*.url:git@github.com:jenkinsci/**"]
	path = ~/.config/git/machine.gitconfig
[includeIf "hasconfig:remote.*.url:ssh://git@github.com/jenkinsci/**"]
	path = ~/.config/git/machine.gitconfig
[includeIf "hasconfig:remote.*.url:https://github.com/jenkinsci/**"]
	path = ~/.config/git/machine.gitconfig
[includeIf "hasconfig:remote.*.url:gh:jenkinsci/**"]
	path = ~/.config/git/machine.gitconfig
