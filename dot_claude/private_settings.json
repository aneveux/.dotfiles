{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "awsAuthRefresh": "aws sso login --profile $AWS_PROFILE",
  "skillListingBudgetFraction": 0.02,
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_PROFILE": "cloudbees-bedrock-claude-infra-bedrock-claude-user",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(rtk read .env)",
      "Bash(rtk read *.env)",
      "Bash(rtk read *.env.*)",
      "Bash(rtk read *.pem)",
      "Bash(rtk read *credentials*)",
      "Bash(rtk read *id_rsa*)",
      "Bash(rtk read *id_ed25519*)",
      "Bash(rtk grep .env)",
      "Bash(rtk grep *.env)",
      "Bash(rtk grep *.env.*)",
      "Bash(rtk grep *.pem)",
      "Bash(rtk grep *credentials*)",
      "Bash(rtk grep *id_rsa*)",
      "Bash(rtk grep *id_ed25519*)",
      "Read(.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Edit(.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/credentials*)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)"
    ]
  },
  "model": "us.anthropic.claude-opus-5",
  "fallbackModel": [
    "opus",
    "sonnet",
    "haiku"
  ],
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude"
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/repo-integrity-scanner.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/security-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Bash|Write|Edit|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/post-bash-security.sh",
            "async": true
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-format.sh",
            "async": true
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-orientation.sh",
            "timeout": 3
          }
        ]
      },
      {
        "matcher": "compact",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/compact-reinjection.sh",
            "timeout": 3
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/pre-compact-snapshot.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "CwdChanged": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/cwd-profile.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stash-reminder.sh",
            "timeout": 2
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.15",
    "padding": 0
  },
  "enabledPlugins": {
    "antoine-voice@claude-secret-garden": true,
    "trellis@claude-garden": true,
    "thorn@claude-garden": true,
    "seed@claude-garden": true,
    "claude-stats@claude-secret-garden": true,
    "qf-inbox@claude-secret-garden": true,
    "cc-safety-net@cc-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudbees": {
      "source": {
        "source": "github",
        "repo": "cloudbees/cloudbees-claude-plugin"
      }
    },
    "claude-garden": {
      "source": {
        "source": "directory",
        "path": "/home/antoine/projects/claude-garden"
      }
    },
    "claude-secret-garden": {
      "source": {
        "source": "directory",
        "path": "/home/antoine/projects/claude-secret-garden"
      }
    },
    "claude-java-stack": {
      "source": {
        "source": "directory",
        "path": "/home/antoine/projects/claude-java-stack/"
      }
    }
  },
  "outputStyle": "Antoine - Engineering",
  "alwaysThinkingEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim"
}
