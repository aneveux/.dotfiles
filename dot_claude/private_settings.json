{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "awsAuthRefresh": "aws sso login --profile $AWS_PROFILE",
  "skillListingBudgetFraction": 0.02,
  "env": {
    "ENABLE_LSP_TOOL": "1",
    "CLAUDE_CODE_USE_BEDROCK": "1",
    "AWS_PROFILE": "cloudbees-bedrock-claude-infra-bedrock-claude-user",
    "CLAUDE_CODE_DISABLE_FEEDBACK_SURVEY": "1",
    "CC_SAFETY_NET_AUDIT_SCOPE": "blocked"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push --force-with-lease*)",
      "Bash(rtk read .env)",
      "Bash(rtk read *.env)",
      "Bash(rtk read *.env.*)",
      "Bash(rtk read *.pem)",
      "Bash(rtk read *credentials*)",
      "Bash(rtk read *id_rsa*)",
      "Bash(rtk read *id_ed25519*)",
      "Bash(rtk grep .env)",
      "Bash(rtk grep *.env)",
      "Bash(rtk grep *.env.*)",
      "Bash(rtk grep *.pem)",
      "Bash(rtk grep *credentials*)",
      "Bash(rtk grep *id_rsa*)",
      "Bash(rtk grep *id_ed25519*)",
      "Read(.env)",
      "Read(**/.env.*)",
      "Read(**/*.pem)",
      "Read(**/credentials*)",
      "Read(**/id_rsa*)",
      "Read(**/id_ed25519*)",
      "Edit(.env)",
      "Edit(**/.env.*)",
      "Edit(**/*.pem)",
      "Edit(**/credentials*)",
      "Edit(**/id_rsa*)",
      "Edit(**/id_ed25519*)",
      "Read(**/*.p12)",
      "Edit(**/*.p12)",
      "Read(**/*.jks)",
      "Edit(**/*.jks)",
      "Read(**/*.keystore)",
      "Edit(**/*.keystore)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.m2/settings-security.xml)",
      "Edit(~/.claude/settings.json)",
      "Edit(~/.claude/hooks/*.sh)",
      "Edit(~/.cc-safety-net/rules/rule.json)",
      "Edit(~/.cc-safety-net/rules/**/rulebook.json)"
    ],
    "allow": [
      "Bash(rtk read *)",
      "Bash(rtk ls *)",
      "Bash(rtk tree *)",
      "Bash(rtk find *)",
      "Bash(rtk grep *)",
      "Bash(rtk rg *)",
      "Bash(rtk diff *)",
      "Bash(rtk wc *)",
      "Bash(rtk git status *)",
      "Bash(rtk git log *)",
      "Bash(rtk git diff *)",
      "Bash(rtk git show *)"
    ]
  },
  "model": "us.anthropic.claude-opus-5",
  "fallbackModel": [
    "opus",
    "sonnet",
    "haiku"
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-handover.sh"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "clear|prompt_input_exit|other",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/session-end-pointer.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "rtk hook claude",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/repo-integrity-scanner.sh"
          }
        ]
      },
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/security-gate.sh",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/auto-format.sh",
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash ~/.claude/hooks/stash-reminder.sh",
            "timeout": 2
          }
        ]
      }
    ],
    "ConfigChange": [
      {
        "matcher": "user_settings",
        "hooks": [
          {
            "type": "command",
            "command": "~/.claude/hooks/config-guard.sh"
          }
        ]
      }
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "npx -y ccstatusline@2.2.15",
    "padding": 0
  },
  "enabledPlugins": {
    "antoine-voice@claude-secret-garden": true,
    "trellis@claude-garden": true,
    "thorn@claude-garden": true,
    "seed@claude-garden": true,
    "claude-stats@claude-secret-garden": true,
    "qf-inbox@claude-secret-garden": true,
    "cc-safety-net@cc-marketplace": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    },
    "cloudbees": {
      "source": {
        "source": "github",
        "repo": "cloudbees/cloudbees-claude-plugin"
      }
    },
    "claude-garden": {
      "source": {
        "source": "directory",
        "path": "/home/antoine/projects/claude-garden"
      }
    },
    "claude-secret-garden": {
      "source": {
        "source": "directory",
        "path": "/home/antoine/projects/claude-secret-garden"
      }
    },
    "claude-java-stack": {
      "source": {
        "source": "directory",
        "path": "/home/antoine/projects/claude-java-stack/"
      }
    }
  },
  "outputStyle": "Antoine - Engineering",
  "alwaysThinkingEnabled": true,
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "editorMode": "vim"
}
