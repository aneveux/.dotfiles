#==============================================================================
# ⚡  Prefix key configuration
#==============================================================================

set -g prefix C-a
unbind C-b
bind-key C-a send-prefix

#==============================================================================
# ⚡  Shell configuration
#==============================================================================

set -g default-shell "${SHELL}"
set -g default-command "${SHELL}"

# Expose mise shims + user bins to plugins (run-shell gets a minimal PATH)
set-environment -g PATH "{{ .chezmoi.homeDir }}/.local/share/mise/shims:{{ .chezmoi.homeDir }}/go/bin:{{ .chezmoi.homeDir }}/.cargo/bin:{{ .chezmoi.homeDir }}/.local/bin:{{ .chezmoi.homeDir }}/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
# Popups (fzf-tab, tmux-fzf-links) get the server environment, not the calling shell's
set-environment -g FZF_DEFAULT_OPTS_FILE "{{ .chezmoi.homeDir }}/.config/fzf/fzfrc"

#==============================================================================
# ⚡  Mouse and terminal
#==============================================================================

set -g mouse on

set -g default-terminal "tmux-256color"
# Reset first: appending on every `prefix r` would stack duplicates
set -su terminal-features
set -sa terminal-features ",xterm-ghostty:RGB:hyperlinks:extkeys:sync:usstyle"
set -sa terminal-features ",xterm-256color:RGB"
set -s extended-keys on
set -s extended-keys-format csi-u
set -g allow-passthrough on
set -gu update-environment
set -ga update-environment TERM
set -ga update-environment TERM_PROGRAM
set -g history-limit 50000
set -g display-time 4000
setw -g aggressive-resize on

set-window-option -g monitor-activity off
set-option -g      visual-activity   off
set-option -g      visual-silence    off
set-option -g      visual-bell       off
set-option -g      bell-action       none

#==============================================================================
# ⚡  Keyboard behavior
#==============================================================================

set -sg escape-time 10

#==============================================================================
# ⚡  Clipboard / Copy / Paste
#==============================================================================

setw -g mode-keys vi

# OSC 52 from apps (nvim, ssh) reaches the system clipboard; copy-pipe uses copy-command
set -s set-clipboard on
set -s copy-command 'xclip -selection clipboard'

unbind [
bind v copy-mode

bind-key -T copy-mode-vi v       send-keys -X begin-selection
bind-key -T copy-mode-vi C-v     send-keys -X rectangle-toggle
bind-key -T copy-mode-vi y       send-keys -X copy-pipe-and-cancel
bind-key -T copy-mode-vi Escape  send -X cancel
bind-key -T copy-mode-vi H       send -X start-of-line
bind-key -T copy-mode-vi L       send -X end-of-line
bind-key -T copy-mode-vi MouseDragEnd1Pane send -X copy-pipe-and-cancel

#==============================================================================
# ⚡  Window and pane options
#==============================================================================

set-option -g allow-rename off
set -g base-index        1
set -g pane-base-index   1
set -g renumber-windows  on
set -g detach-on-destroy off
set -g focus-events      on

#==============================================================================
# ⚡  Clean up conflicting defaults
#==============================================================================

unbind c        # new-window        → w,n (preserves path)
unbind n        # next-window       → M-l
unbind p        # previous-window   → M-h (p = pane table)
unbind s        # choose-tree       → s,s (s = session table)
unbind w        # choose-tree       → w,s (w = window table)
unbind f        # find-window       → w,f (f = floax)
unbind %        # split-h           → p,| or direct |
unbind '"'      # split-v           → p,- or direct -
unbind &        # kill-window       → w,x
unbind ','      # rename-window     → w,r
unbind '$'      # rename-session    → s,r
unbind ';'      # last-pane         → p,a

#==============================================================================
# ⚡  Root bindings (no prefix — instant access)
#==============================================================================
#
#   Horizontal = windows    M-h ←  M-l →
#   Vertical   = sessions   M-k ↑  M-j ↓
#   Pane nav   = C-hjkl     (via vim-tmux-navigator)
#

# Window cycling
bind -n M-h previous-window
bind -n M-l next-window

# Session cycling
bind -n M-j switch-client -n
bind -n M-k switch-client -p

# Session picker (same key as the zsh widget outside tmux)
bind -n M-s display-popup -E -w 80% -h 70% -b rounded -S 'fg=#89b4fa' -T ' Sesh ' "sesh picker -idH"

# Pane resize
bind -n C-M-Left  resize-pane -L 5
bind -n C-M-Right resize-pane -R 5
bind -n C-M-Up    resize-pane -U 5
bind -n C-M-Down  resize-pane -D 5

#==============================================================================
# ⚡  Direct prefix bindings (C-a + key)
#==============================================================================

# Mnemonic tables
bind w switch-client -T window
bind p switch-client -T pane
bind s switch-client -T session

# Speed aliases (also available in their respective tables)
bind | split-window -h -c "#{pane_current_path}"
bind - split-window -v -c "#{pane_current_path}"
bind x kill-pane
bind-key o display-popup -E -w 80% -h 70% -d '#{pane_current_path}' -b rounded -S 'fg=#89b4fa' -T ' Sesh ' "sesh picker -idH"

# Tasks 
bind-key t display-popup -E -w 60% -h 30% 'tsk'
bind-key T display-popup -E -w 80% -h 60% 'tsk pick'

# Utility
bind b send-prefix
bind d detach-client
bind r source-file ~/.tmux.conf \; display-message "🔁 Tmux config reloaded!"
bind-key S display-popup -E -w 80% -h 60% 'd=$(fd -td -d1 . ~/projects | fzf --preview "eza --git --icons --color=always {}") && stash -C "$d"'
bind-key N run-shell "~/projects/quickflow/qf inbox --next"
bind-key C-g display-popup -E -w 70% -h 70% "tmux-file-picker -g"

# workmux
bind-key W display-popup -E -w 80% -h 60% -b rounded -S 'fg=#89b4fa' -T ' workmux ' "workmux dashboard"
bind-key L run-shell "workmux last-done"

#==============================================================================
# ⚡  Window table (C-a w → key)
#==============================================================================
#
#   n = new   x = kill   r = rename   f = find
#   h/l = swap left/right   a = alternate   s = select
#

bind -T window n new-window -c "#{pane_current_path}"
bind -T window x confirm-before -p "kill-window #W? (y/n)" kill-window
bind -T window r command-prompt -I "#W" { rename-window "%%" }
bind -T window h swap-window -t -1\; select-window -t -1
bind -T window l swap-window -t +1\; select-window -t +1
bind -T window f command-prompt { find-window -Z "%%" }
bind -T window a last-window
bind -T window s choose-tree -Zw

#==============================================================================
# ⚡  Pane table (C-a p → key)
#==============================================================================
#
#   |/- = split   x = kill   z = zoom
#   h/j/k/l = navigate   H/J/K/L = resize (repeatable)
#   a = alternate   m = mark   q = quick pick
#   Space = cycle layout   o = rotate   ! = break to window
#

# Split
bind -T pane | split-window -h -c "#{pane_current_path}"
bind -T pane - split-window -v -c "#{pane_current_path}"

# Manage
bind -T pane x kill-pane
bind -T pane z resize-pane -Z

# Navigate
bind -T pane h select-pane -L
bind -T pane j select-pane -D
bind -T pane k select-pane -U
bind -T pane l select-pane -R
bind -T pane a last-pane

# Resize (repeatable: C-a p H H H)
bind -r -T pane H resize-pane -L 5
bind -r -T pane J resize-pane -D 5
bind -r -T pane K resize-pane -U 5
bind -r -T pane L resize-pane -R 5

# Swap and layout
bind -T pane \{ swap-pane -U
bind -T pane \} swap-pane -D
bind -T pane ! break-pane
bind -T pane Space next-layout
bind -T pane o rotate-window

# Utility
bind -T pane m select-pane -m
bind -T pane q display-panes

#==============================================================================
# ⚡  Session table (C-a s → key)
#==============================================================================
#
#   o = open (sesh)   n = new   r = rename
#   a = alternate (last)   x = kill   d = detach   s = select
#

bind -T session o display-popup -E -w 80% -h 70% -d '#{pane_current_path}' -b rounded -S 'fg=#89b4fa' -T ' Sesh ' "sesh picker -idH"
bind -T session n command-prompt -p "new session:" "new-session -s '%%'"
bind -T session r command-prompt -I "#S" { rename-session "%%" }
bind -T session a run-shell "sesh last"
bind -T session x confirm-before -p "kill-session #S? (y/n)" kill-session
bind -T session d detach-client
bind -T session s choose-tree -Zs

#==============================================================================
# ⚡  Status bar
#==============================================================================

set-option -g status-position top
set -g status-justify  left
set -g status-interval 2
set -g status-left-length  40
set -g status-right-length 60

#==============================================================================
# ⚡  Plugins
#==============================================================================

# christoomey/vim-tmux-navigator ----------------------------------------------
set -g @plugin 'christoomey/vim-tmux-navigator'
# prefix C-l belongs to tmux-fzf-links
set -g @vim_navigator_prefix_mapping_clear_screen ''

# laktak/extrakto -------------------------------------------------------------
set -g @plugin 'laktak/extrakto'
set-option -g @extrakto_key 'C-f'

# lost-melody/tmux-command-palette --------------------------------------------
set -g @plugin 'lost-melody/tmux-command-palette'
set -g @cmdpalette-render-cmd 'bat -l md -f -pp'
# Default tables steal copy-mode-vi ? (search backward); prefix ? is cheatmux's.
# Custom tables get a which-key style help on ? (C-a w ?, C-a p ?, C-a s ?)
set -g @cmdpalette-tables 'root,window,pane,session'

# catppuccin/tmux -------------------------------------------------------------
set -g @plugin 'catppuccin/tmux#v2.3.2'
set -g @catppuccin_flavor 'mocha'
set -g @catppuccin_window_status_style 'rounded'

# workmux agent status (status_format: false in workmux config) + zoom flag
set -g @catppuccin_window_text " #W#{?@workmux_status, #{@workmux_status},}#{?window_zoomed_flag, 󰁌,}"
set -g @catppuccin_window_current_text " #W#{?@workmux_status, #{@workmux_status},}#{?window_zoomed_flag, 󰁌,}"

set -g status-left "#{E:@catppuccin_status_session} "
set -g status-right "#{E:@catppuccin_status_gitmux}"
set -ga status-right '#{?#{@qf_inbox_count}, 🔔 #{@qf_inbox_count},}'

# alberti42/tmux-fzf-links ---------------------------------------------------
set -g @plugin 'alberti42/tmux-fzf-links'
set-option -g @fzf-links-editor-open-cmd "tmux new-window -n 'nvim' nvim +%line '%file'"
set-option -g @fzf-links-browser-open-cmd "firefox '%url'"
set-option -g @fzf-links-key C-l

# MaximilianGaedig/tmux-filter ------------------------------------------------
set -g @plugin 'MaximilianGaedig/tmux-filter'

# aneveux/cheatmux ------------------------------------------------------------
set -g @plugin 'aneveux/cheatmux'

# omerxx/tmux-floax -----------------------------------------------------------
set -g @plugin 'omerxx/tmux-floax'
set -g @floax-bind 'f'

#==============================================================================
# ⚡  Plugin manager bootstrap
#==============================================================================

# tmux-plugins/tpm ------------------------------------------------------------
set -g @plugin 'tmux-plugins/tpm'

if "test ! -d ~/.tmux/plugins/tpm" \
  "run 'git clone https://github.com/tmux-plugins/tpm ~/.tmux/plugins/tpm'"
run '~/.tmux/plugins/tpm/tpm'

# Override gitmux module to use custom script (no gitmux binary needed)
set -g @catppuccin_gitmux_text ' #(~/.tmux/scripts/git-info.sh "#{pane_current_path}")'
