let g:argtextobj_pairs = "[:],(:),<:>"

""" which-key — https://github.com/brandonkramer/which-key-lazy
""" `set which-key` above activates Which Key Lazy: it registers the same
""" IdeaVIM extension name ("which-key") as TheBlob42/idea-which-key, so only
""" one of the two can ever be enabled. The old plugin is currently disabled.
"""
""" Which Key Lazy reads ONLY g:WhichKeyDesc_* from this file. Appearance and
""" behaviour live in ~/.whichkey-lazy.json (managed as dot_whichkey-lazy.json);
""" edit it and run "Which Key Lazy: Reload Config" to apply without a restart.
"""
""" It needs no popup mapping of its own and no g:WhichKey_* settings — those
""" belonged to idea-which-key and are silently ignored here. If you ever swap
""" back (Which Key Lazy declares until-build=262.*, so 2026.3 will break it),
""" restore: DefaultDelay=200, FontSize=16, SortOrder="by_key_prefix_first",
""" ShowTypedSequence/ShowVimActions/ProcessUnknownMappings="true".
"""
""" Trade-off of the swap: labels resolve WhichKeyDesc_ → LazyVim group default
""" → IDE action name → humanised action ID, so an unlabelled leader mapping
""" still reads sensibly. But discovery is leader-scoped only — the built-in
""" Vim verbs that ShowVimActions used to surface no longer appear.

""" cmdfloat — https://github.com/yelog/IdeaVim-CmdFloat
""" Intercepts : / ? on its own; no mappings needed. Its default
""" single_char_argument_keys list contains "g", which would swallow one key
""" after g and break the 3-key sequences here (gsa/gsd/gsr surround, gcc
""" comment, grr ReplaceWithRegister), so g is dropped from the list.
""" "s"/"S" stay in extended_search_keys — that is exactly vim-flash's `s`.
let g:cmdfloat_single_char_argument_keys = ['f', 't', 'F', 'T', 'r', 'm', '\'', '`', '@', 'q', 'z', 'Z']


