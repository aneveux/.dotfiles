{{- /*
  Rendered output must stay comment-free: rtk parses this file to decide whether a rewrite would
  change a permission verdict, and it fails open on JSONC comments. Explanations live in these
  template comments instead.
*/ -}}
{{- $home := .chezmoi.homeDir -}}
{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/us.anthropic.claude-opus-5-5",
  "providers": {
    "amazon-bedrock": {
      "settings": {
        "region": "us-east-1",
        "profile": "cloudbees-bedrock-claude-infra-bedrock-claude-user"
      }
    }
  },
  "agents": {
    "build": { "model": "amazon-bedrock/us.anthropic.claude-opus-5-5#high" },
    "plan": { "model": "amazon-bedrock/us.anthropic.claude-opus-5-5#high" },
    "general": { "model": "amazon-bedrock/us.anthropic.claude-opus-5-5#medium" },
    "explore": { "model": "amazon-bedrock/us.anthropic.claude-sonnet-5-5#low" },
    "compaction": { "model": "amazon-bedrock/us.anthropic.claude-sonnet-5-5" },
    "title": { "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5" },
    "summary": { "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5" },
    "opencode-memory-recall": { "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5" },
    "opencode-memory-extract": { "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5", "steps": 20 },
    "opencode-memory-dream": { "model": "amazon-bedrock/us.anthropic.claude-sonnet-5-5" },
    "safe": {
      "description": "Asks before shell commands, edits and web access",
      "mode": "primary",
      "model": "amazon-bedrock/us.anthropic.claude-opus-5-5#high",
      "color": "#a6e3a1",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "ask" },
        { "action": "websearch", "resource": "*", "effect": "ask" },
        { "action": "execute", "resource": "*", "effect": "ask" },
        { "action": "subagent", "resource": "*", "effect": "ask" }
      ]
    }
  },
{{- /* mise owns upgrades */}}
  "update": "disable",
  "share": "disabled",
  "compaction": { "auto": true },
{{- /* V2 only reads AGENTS.md; this keeps repos that only ship a CLAUDE.md working, resolved per project */}}
  "instructions": ["CLAUDE.md"],
  "mcp": {
    "servers": {
      "atlassian": { "type": "remote", "url": "https://mcp.atlassian.com/v2/mcp" }
    }
  },
  "plugins": [
    { "package": "cc-safety-net@2.6.19", "options": { "shell": "posix" } },
    "opencode-handoff@0.6.1",
    "opencode-claude-memory@2.2.1",
    "{{ $home }}/projects/opencode/plugins/claude-hooks"
  ],
{{- /*
  formatter: an object enables the built-ins (prettier, shfmt, gofmt, ruff...) plus spotless.
  Formatters run synchronously after each edit, so spotless uses mvnd and never fails the edit.
  `.no-spotless` at the project root opts out, as with the Claude auto-format hook.
*/}}
  "formatter": {
    "spotless": {
      "command": ["sh", "-c", "[ -f pom.xml ] && [ ! -f .no-spotless ] && mvnd -q spotless:apply -DspotlessFiles=\"$1\" >/dev/null 2>&1; exit 0", "spotless", "$FILE"],
      "extensions": [".java"]
    }
  },
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "ask" }
  ],
{{- /*
  Hard limits: policies hold in every agent, in --yolo and against saved approvals.
  Last match wins. Resources are relative inside the project and absolute outside it, so secret
  patterns start with `*` to match both. rtk does not read policies and rewrites `git push` into
  `rtk git push`, which opencode then evaluates, so every shell policy has an `rtk` twin.
  Project config (.opencode/, opencode.json*) is edit-denied because it can drop plugins such as
  cc-safety-net and auto-load plugin code; plan mode's own files are lifted back out.
*/}}
{{- $secrets := list
  "*.env" "*.env.*" "*.envrc" "*.pem" "*.key" "*credentials*"
  "id_rsa*" "*/id_rsa*" "id_ed25519*" "*/id_ed25519*" "id_ecdsa*" "*/id_ecdsa*"
  "*.p12" "*.jks" "*.keystore" "*.tfstate" "*.tfstate.*"
  "*.m2/settings*.xml" "*.aws/*" "*.ssh/*" "*opencode/service.json" "*opencode/auth.json" }}
{{- $guarded := list
  (printf "%s/.config/opencode/*" $home) (printf "%s/.claude/settings.json" $home)
  (printf "%s/.claude/hooks/*" $home) (printf "%s/.cc-safety-net/*" $home)
  "*.opencode/*" "*opencode.json" "*opencode.jsonc" }}
{{- $forcePush := list "git push *--force*" "git push -f*" "git push * -f" "git push * -f *" }}
  "policies": [
{{- range $tool := list "read" "edit" }}
{{- range $secrets }}
    { "action": "tool.use", "resource": "{{ $tool }}:{{ . }}", "effect": "deny" },
{{- end }}
    { "action": "tool.use", "resource": "{{ $tool }}:*.env.example", "effect": "allow" },
{{- end }}
{{- range $guarded }}
    { "action": "tool.use", "resource": "edit:{{ . }}", "effect": "deny" },
{{- end }}
    { "action": "tool.use", "resource": "edit:{{ $home }}/.opencode/plan/*", "effect": "allow" },
{{- range $index, $command := $forcePush }}
    { "action": "tool.use", "resource": "shell:{{ $command }}", "effect": "deny" },
    { "action": "tool.use", "resource": "shell:rtk {{ $command }}", "effect": "deny" }{{ if lt (add1 $index) (len $forcePush) }},{{ end }}
{{- end }}
  ]
}
