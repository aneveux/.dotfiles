{{- /*
  Rendered output must stay comment-free: rtk parses this file to decide whether a rewrite would
  change a permission verdict, and it fails open on JSONC comments. Explanations live in these
  template comments instead.
*/ -}}
{{- $home := .chezmoi.homeDir -}}
{
  "$schema": "https://opencode.ai/config.json",
  "model": "amazon-bedrock/us.anthropic.claude-opus-5-5",
  "providers": {
    "amazon-bedrock": {
      "settings": {
        "region": "us-east-1",
        "profile": "cloudbees-bedrock-claude-infra-bedrock-claude-user"
      }
    }
  },
  "agents": {
    "build": { "model": "amazon-bedrock/us.anthropic.claude-opus-5-5#high" },
    "plan": { "model": "amazon-bedrock/us.anthropic.claude-opus-5-5#high" },
    "general": { "model": "amazon-bedrock/us.anthropic.claude-opus-5-5#medium" },
    "explore": {
      "model": "amazon-bedrock/us.anthropic.claude-sonnet-5-5#low",
{{- /* Global permissions are appended after explore's own `* deny`: without these, it would get MCP tools as direct tools */}}
      "permissions": [
        { "action": "atlassian_*", "resource": "*", "effect": "deny" },
        { "action": "slack_*", "resource": "*", "effect": "deny" },
        { "action": "cbci_*", "resource": "*", "effect": "deny" }
      ]
    },
    "compaction": { "model": "amazon-bedrock/us.anthropic.claude-sonnet-5-5" },
    "title": { "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5" },
    "summary": { "model": "amazon-bedrock/us.anthropic.claude-haiku-5-5" },
    "safe": {
      "description": "Asks before shell commands, edits and web access; no subagents",
      "mode": "primary",
      "model": "amazon-bedrock/us.anthropic.claude-opus-5-5#high",
      "color": "#a6e3a1",
      "permissions": [
        { "action": "shell", "resource": "*", "effect": "ask" },
        { "action": "shell", "resource": "git status", "effect": "allow" },
        { "action": "shell", "resource": "git status *", "effect": "allow" },
        { "action": "shell", "resource": "git diff", "effect": "allow" },
        { "action": "shell", "resource": "git diff *", "effect": "allow" },
        { "action": "shell", "resource": "git log", "effect": "allow" },
        { "action": "shell", "resource": "git log *", "effect": "allow" },
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "webfetch", "resource": "*", "effect": "ask" },
        { "action": "websearch", "resource": "*", "effect": "ask" },
        { "action": "execute", "resource": "*", "effect": "ask" },
        { "action": "subagent", "resource": "*", "effect": "deny" }
      ]
    }
  },
{{- /* mise owns upgrades */}}
  "update": "disable",
  "share": "disabled",
  "compaction": { "auto": true },
{{- /* V2 only reads AGENTS.md; this keeps repos that only ship a CLAUDE.md working, resolved per project */}}
  "instructions": ["CLAUDE.md"],
{{- /* Every server is off by default; the opencode-context plugin turns on those its options list in work locations */}}
  "mcp": {
    "servers": {
      "atlassian": { "type": "remote", "url": "https://mcp.atlassian.com/v2/mcp", "disabled": true },
      "slack": {
        "type": "remote",
        "url": "https://mcp.slack.com/mcp",
        "oauth": { "client_id": "1601185624273.8899143856786", "redirect_uri": "http://localhost:3118/callback" },
        "disabled": true
      },
      "cbci": {
        "type": "remote",
        "url": "https://dogfooding.cloudbees.com/mcp-router/mcp",
        "oauth": { "client_id": "ci-mcp-client" },
        "disabled": true
      }
    }
  },
  "plugins": [
    "cc-safety-net@2.7.8",
    "opencode-handoff@0.7.0",
    "github:aneveux/opencode-antoine-voice#v0.3.1",
    {
      "package": "github:aneveux/opencode-context#v0.1.0",
      "options": { "orgs": ["cloudbees", "jenkinsci", "jenkins-infra"], "servers": ["atlassian", "slack", "cbci"] }
    },
    "{{ $home }}/projects/opencode-java-stack"
  ],
{{- /*
  formatter: an object enables the built-ins (prettier, shfmt, gofmt, ruff...) plus spotless.
  Formatters run synchronously after each edit, so spotless uses mvnd and never fails the edit.
  `.no-spotless` at the project root opts out, as with the Claude auto-format hook.
*/}}
  "formatter": {
    "spotless": {
      "command": ["sh", "-c", "[ -f pom.xml ] && [ ! -f .no-spotless ] && mvnd -q spotless:apply -DspotlessFiles=\"$1\" >/dev/null 2>&1; exit 0", "spotless", "$FILE"],
      "extensions": [".java"]
    }
  },
{{- /* MCP write tools ask, listed reads run; a tool a server adds later asks. Asks need a TUI without --yolo */}}
  "permissions": [
    { "action": "external_directory", "resource": "*", "effect": "allow" },
    { "action": "atlassian_*", "resource": "*", "effect": "ask" },
    { "action": "atlassian_get*", "resource": "*", "effect": "allow" },
    { "action": "atlassian_search*", "resource": "*", "effect": "allow" },
    { "action": "atlassian_list*", "resource": "*", "effect": "allow" },
    { "action": "atlassian_discover", "resource": "*", "effect": "allow" },
    { "action": "atlassian_executeRead", "resource": "*", "effect": "allow" },
    { "action": "atlassian_atlassianUserInfo", "resource": "*", "effect": "allow" },
{{- /* Slack names its tools slack_*, so actions read slack_slack_*. get_file_upload_url starts an upload */}}
    { "action": "slack_*", "resource": "*", "effect": "ask" },
    { "action": "slack_slack_read_*", "resource": "*", "effect": "allow" },
    { "action": "slack_slack_search_*", "resource": "*", "effect": "allow" },
    { "action": "slack_slack_list_*", "resource": "*", "effect": "allow" },
    { "action": "slack_slack_get_reactions", "resource": "*", "effect": "allow" },
    { "action": "cbci_*", "resource": "*", "effect": "ask" },
    { "action": "cbci_get*", "resource": "*", "effect": "allow" },
    { "action": "cbci_find*", "resource": "*", "effect": "allow" },
    { "action": "cbci_list*", "resource": "*", "effect": "allow" },
    { "action": "cbci_search*", "resource": "*", "effect": "allow" },
    { "action": "cbci_whoAmI", "resource": "*", "effect": "allow" }
  ],
{{- /*
  Hard limits: policies hold in every agent, in --yolo and against saved approvals.
  Last match wins. Resources are relative inside the project and absolute outside it, so secret
  patterns start with `*` to match both. Shell-level blocking (force push, secret reads from the
  shell) is cc-safety-net's job: it parses commands and sees through `rtk` as a wrapper.
  Project config (.opencode/, opencode.json*) is edit-denied because it can drop plugins such as
  cc-safety-net and auto-load plugin code; plan mode's own files are lifted back out.
  Mutating chezmoi commands are denied so nothing reaches the live config without a manual
  `chezmoi apply`: --yolo auto-approves asks. execute-template stays denied, it can include any
  file and run commands.
*/}}
{{- $secrets := list
  "*.env" "*.env.*" "*.envrc" "*.pem" "*.key"
  "credentials" "*/credentials" "credentials.json" "*/credentials.json"
  ".credentials.json" "*/.credentials.json" ".git-credentials" "*/.git-credentials"
  ".netrc" "*/.netrc" ".npmrc" "*/.npmrc" ".pypirc" "*/.pypirc" ".vault-token" "*/.vault-token"
  ".docker/config.json" "*/.docker/config.json" ".kube/config" "*/.kube/config"
  ".config/gh/hosts.yml" "*/.config/gh/hosts.yml" ".gradle/gradle.properties" "*/.gradle/gradle.properties"
  "id_rsa*" "*/id_rsa*" "id_ed25519*" "*/id_ed25519*" "id_ecdsa*" "*/id_ecdsa*"
  "*.p12" "*.jks" "*.keystore" "*.tfstate" "*.tfstate.*"
  "*.m2/settings*.xml" "*.aws/*" "*.ssh/*" "*opencode/service.json" "*opencode/auth.json" }}
{{- $guarded := list
  (printf "%s/.config/opencode/*" $home) (printf "%s/.claude/settings.json" $home)
  (printf "%s/.claude/hooks/*" $home) (printf "%s/.cc-safety-net/*" $home)
  "*.opencode/*" "*opencode.json" "*opencode.jsonc" }}
  "policies": [
{{- range $tool := list "read" "edit" }}
{{- range $secrets }}
    { "action": "tool.use", "resource": "{{ $tool }}:{{ . }}", "effect": "deny" },
{{- end }}
    { "action": "tool.use", "resource": "{{ $tool }}:*.env.example", "effect": "allow" },
{{- end }}
{{- range $guarded }}
    { "action": "tool.use", "resource": "edit:{{ . }}", "effect": "deny" },
{{- end }}
    { "action": "tool.use", "resource": "shell:chezmoi *", "effect": "deny" },
{{- range list "diff" "status" "cat" "managed" "source-path" }}
    { "action": "tool.use", "resource": "shell:chezmoi {{ . }} *", "effect": "allow" },
{{- end }}
    { "action": "tool.use", "resource": "edit:{{ $home }}/.opencode/plan/*", "effect": "allow" }
  ]
}
