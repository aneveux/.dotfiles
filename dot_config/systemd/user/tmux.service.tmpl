[Unit]
Description=tmux default session (detached)
Documentation=man:tmux(1)

[Service]
Type=forking
{{- if eq .machine "flower" }}
Environment=DISPLAY=:0
{{- else }}
Environment=WAYLAND_DISPLAY=wayland-0
{{- end }}
ExecStart=%h/.local/share/mise/shims/tmux new-session -d

ExecStop=%h/.local/share/mise/shims/tmux kill-server
KillMode=control-group

RestartSec=2

[Install]
WantedBy=default.target
