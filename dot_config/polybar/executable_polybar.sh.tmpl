#!/usr/bin/env bash
# main idea from https://github.com/polybar/polybar/issues/763#issuecomment-450940924
readonly log_dir="${XDG_CACHE_HOME:-$HOME/.cache}/polybar"
readonly runtime_dir="${XDG_RUNTIME_DIR:-/tmp}"
mkdir -p "$log_dir"

(
  flock -w 15 200 || exit 1

  killall -q polybar

  for _ in $(seq 20); do
    pgrep -u $UID -x polybar >/dev/null || break
    sleep 0.25
  done

  if pgrep -u $UID -x polybar >/dev/null; then
    killall -q -9 polybar
    sleep 0.5
  fi

  # tail = true scripts outlive their bar when it gets killed
  pkill -u $UID -f "$HOME/.config/polybar/scripts/"
  pkill -u $UID -f 'pulseaudio-control .*listen'

  outputs=$(xrandr --query | grep " connected " | cut -d" " -f1)
  primary=$(xrandr --query | grep " primary " | cut -d" " -f1)

  for m in $outputs; do
    export MONITOR="$m"
    if test "$m" = "$primary"; then
      bar_config='main'
    else
      bar_config='secondary'
    fi
    polybar --reload "$bar_config" -c ~/.config/polybar/config.ini </dev/null >"$log_dir/polybar-$m.log" 2>&1 200>&- &
    if test "$bar_config" = 'main'; then
      echo $! >"$runtime_dir/polybar-main.pid"
    fi
    disown
  done
) 200>"$runtime_dir/polybar-launch.lock"
