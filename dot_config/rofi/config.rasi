configuration {
    font: "Iosevka Nerd Font 12";

    modes: "combi,window,drun";
    combi-modes: "window,drun";

    case-sensitive: false;
    sort: true;
    sorting-method: "levenshtein";
    matching: "fuzzy";
    tokenize: true;

    fixed-num-lines: true;
    show-icons: true;
    icon-theme: "Papirus-Dark";

    drun-display-format: "{icon} {name}";
    location: 0;
    disable-history: false;
    display-drun: "   Apps ";
    display-run: "   Run ";
    display-window: " 󰕰  Window";
    sidebar-mode: true;

    terminal: "ghostty";
    ssh-client: "ssh";
    ssh-command: "{terminal} -e zsh -ic \"{ssh-client} {host}\"";
    run-command: "{cmd}";
    run-list-command: "";
    run-shell-command: "{terminal} -e {cmd}";

	parse-hosts: true;
	parse-known-hosts: true;

  timeout {
      action: "kb-cancel";
      delay:  0;
  }

  filebrowser {
      directories-first: true;
      sorting-method: "name";
  }

}

@theme "catppuccin"
