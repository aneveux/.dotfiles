export LANG='en_US.UTF-8'

export GTK_THEME='Catppuccin-Blue-Dark:dark'

export MANPAGER='nvim +Man!'
export MANWIDTH=999                     # no hard wrap from groff; nvim soft-wraps (:h manpager)
export PAGER='less'

# a missing file makes every fzf call fail, hence the guard
[ -r "$HOME/.config/fzf/fzfrc" ] && export FZF_DEFAULT_OPTS_FILE="$HOME/.config/fzf/fzfrc"

export TERMINAL='/usr/bin/ghostty'
export BROWSER='firefox'
export EDITOR='nvim'
export VISUAL='nvim'
export TEXT_EDITOR='nvim'
export GIT_EDITOR='nvim'

export GITHUB_ORGANIZATIONS="jenkinsci,cloudbees,aneveux"
export GITHUB_USERNAME='aneveux'
export WORKSPACE="$HOME/projects"
export PROJECTS="$WORKSPACE"

export GPG_TTY=$TTY

gpg-connect-agent updatestartuptty /bye >/dev/null 2>&1
