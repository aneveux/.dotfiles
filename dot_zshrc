#==============================================================================
# ⚡  Early initialisation
#==============================================================================

# user-specific fragments ------------------------------------------------------
[[ -f $HOME/.exports  ]] && source $HOME/.exports
[[ -f $HOME/.keyboard ]] && source $HOME/.keyboard
# ~/.aliases is sourced after the modular config below, so its aliases (rm -iv, mv -v)
# don't get expanded inside plugin and zshrc.d functions

# PATH ------------------------------------------------------------------------
typeset -U path PATH          # keep both arrays unique

# helper: append directory to $path only if it exists
_append_if_dir() { [[ -d "$1" ]] && path+="$1" }

# language/tool-specific bins
_append_if_dir ${KREW_ROOT:-$HOME/.krew}/bin
_append_if_dir $HOME/bin
_append_if_dir $HOME/.local/bin
_append_if_dir $HOME/.cargo/bin
_append_if_dir $HOME/go/bin

#==============================================================================
# ⚡  Zinit bootstrap
#==============================================================================

export ZINIT_HOME=${XDG_DATA_HOME:-$HOME/.local/share}/zinit/zinit
if [[ ! -f $ZINIT_HOME/zinit.zsh ]]; then
  mkdir -p $ZINIT_HOME
  git clone --depth 1 https://github.com/zdharma-continuum/zinit $ZINIT_HOME
fi
# One completion dump for us and zinit (zinit's own compinit calls default to ~/.zcompdump)
typeset -gA ZINIT
ZINIT[ZCOMPDUMP_PATH]="${XDG_CACHE_HOME:-$HOME/.cache}/zcompdump-${ZSH_VERSION}"
source $ZINIT_HOME/zinit.zsh

# generated completion files
mkdir -p ~/.zfunc
fpath+=~/.zfunc

# Generate a completion when missing or older than the tool binary (i.e. after an upgrade);
# atomic write so a failing command never leaves an empty file.
# Only for tools carapace doesn't cover: carapace's compdef runs later and wins for the rest.
ensure_completion() {
  (( $+commands[$1] )) || return 0
  local file=~/.zfunc/_$1 bin=${commands[$1]}; shift
  [[ -s $file && $file -nt $bin ]] && return
  if "$@" >| $file.tmp && [[ -s $file.tmp ]]; then
    command mv -f $file.tmp $file
  else
    command rm -f $file.tmp
  fi
}
ensure_completion mise mise completion zsh

autoload -Uz compinit
# Reuses the dump unless fpath file count or zsh version changes; compaudit still runs each start
compinit -d "$ZINIT[ZCOMPDUMP_PATH]"

#==============================================================================
# ⚡  Core plugins & completions
#==============================================================================

# fast-theme compiles the chezmoi-managed ini into $FAST_WORK_DIR; (re)do it when missing or the ini
# is newer (zsh's -nt is false when the right-hand file doesn't exist, hence the ! -e)
zinit wait lucid for \
  atload'[[ ! -e $FAST_WORK_DIR/current_theme.zsh || ~/.config/fsh/catppuccin-mocha.ini -nt $FAST_WORK_DIR/current_theme.zsh ]] && fast-theme -q XDG:catppuccin-mocha' \
    zdharma-continuum/fast-syntax-highlighting \
  blockf \
    zsh-users/zsh-completions \
  atload"!_zsh_autosuggest_start" \
    zsh-users/zsh-autosuggestions

# Replay compdef calls zinit recorded during plugin loads, after the turbo plugins above
zinit ice wait'0c' lucid as'null' id-as'zinit/cdreplay' atload'zicdreplay -q'
zinit light zdharma-continuum/null

# mise ------------------------------------------------------------------------
# Before carapace so it runs the mise-installed binary directly instead of through the shim
eval "$(mise activate zsh)"
export LS_COLORS="$(vivid generate catppuccin-mocha)"

# Load order matters: compinit -> carapace -> fzf-tab.
# Carapace loading AFTER fzf-tab corrupts fzf-tab's compadd hook on second completion.
export CARAPACE_BRIDGES='zsh,fish,bash,inshellisense'
export CARAPACE_EXCLUDES='ls,cat,mv,cp,ln,rm,vi,nvim'   # still needed with carapace 1.8.1
export CARAPACE_MATCH=1
source <(carapace _carapace)

# Restore native zsh completions for basic file commands (carapace breaks fzf-tab for these)
for cmd in ${(s:,:)CARAPACE_EXCLUDES}; do
  unfunction "_$cmd" 2>/dev/null
  compdef _files "$cmd"
done; unset cmd

zinit light Aloxaf/fzf-tab

# zsh-vi-mode resets keymaps on init (^I, viins ^R); re-bind after it settles
function zvm_after_init() {
  bindkey -M viins '^R' atuin-search-viins
  bindkey -M viins '^D' clear-screen
  bindkey -M vicmd '^D' clear-screen
  bindkey -M viins '^F' forward-word        # accept next word of the autosuggestion
  enable-fzf-tab
}

ZVM_SYSTEM_CLIPBOARD_ENABLED=true
# zvm picks wl-copy whenever it is installed, which silently fails on X11
if [[ -z $WAYLAND_DISPLAY ]]; then
  ZVM_CLIPBOARD_COPY_CMD='xclip -selection clipboard'
  ZVM_CLIPBOARD_PASTE_CMD='xclip -selection clipboard -o'
fi
zinit ice depth=1
zinit light jeffreytse/zsh-vi-mode

# lean OMZ snippets -----------------------------------------------------------
zinit snippet OMZ::plugins/extract/extract.plugin.zsh

#==============================================================================
# ⚡  Custom tools (loaded through eval)
#==============================================================================

eval "$(zoxide init zsh --cmd cd)"
eval "$(atuin init zsh)"
eval "$(starship init zsh)"

#==============================================================================
# ⚡  Zsh options, key-bindings, history
#==============================================================================

# nice defaults ---------------------------------------------------------------
setopt auto_cd interactivecomments extended_glob
setopt notify
setopt complete_in_word
setopt no_list_ambiguous
setopt no_beep
setopt IGNORE_EOF                       # disable default Ctrl+D (logout)

unsetopt correct correct_all            # no automatic spelling correction

# history ---------------------------------------------------------------------
# Atuin is the history store; zsh keeps an in-memory list only (atuin's preexec hook and !! need it)
unset HISTFILE
HISTSIZE=10000
SAVEHIST=0
setopt hist_ignore_all_dups hist_ignore_space hist_reduce_blanks hist_verify

#==============================================================================
# ⚡  completion configuration
#==============================================================================

# Completion styling ----------------------------------------------------------
zstyle ':completion::complete:*' use-cache on
zstyle ':completion::complete:*' cache-path "${XDG_CACHE_HOME:-$HOME/.cache}/zsh/.zcache"
# fzf-tab README: menu no lets fzf-tab capture the unambiguous prefix
zstyle ':completion:*' menu no
zstyle ':completion:*:cd:*' ignore-parents parent pwd
zstyle ':completion:*' matcher-list \
      'm:{a-zA-Z}={A-Za-z}' \
      'r:|[._-]=* r:|=*' \
      'l:|=* r:|=*'
zstyle ':completion:*' group-name ''
# plain text: fzf-tab ignores escape sequences and matches $group against it in previews
zstyle ':completion:*:descriptions' format '[%d]'
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

#==============================================================================
# ⚡  fzf-tab configuration
#==============================================================================
# Colors and shared look live in ~/.config/fzf/fzfrc (FZF_DEFAULT_OPTS_FILE, see ~/.exports).
# fzf-tab blanks FZF_DEFAULT_OPTS but still reads that file, so only fzf-tab-specific flags go here.

zstyle ':fzf-tab:*'             fzf-flags --bind=tab:accept --info=inline-right
zstyle ':fzf-tab:*'             switch-group '<' '>'
zstyle ':fzf-tab:*'             show-group quiet
zstyle ':fzf-tab:*'             single-group header
if [[ -n $TMUX ]]; then
  zstyle ':fzf-tab:*'           fzf-command ftb-tmux-popup
  zstyle ':fzf-tab:*'           popup-smart-tab no      # otherwise tab:up overrides tab:accept
  zstyle ':fzf-tab:*'           popup-min-size 60 10
  zstyle ':fzf-tab:complete:cd:*' popup-pad 30 0
else
  zstyle ':fzf-tab:*'           fzf-command fzf
fi

# previews --------------------------------------------------------------------
# carapace owns git/systemctl, so contexts are ':complete:git:*' (not git-add); dispatch on $words.
# carapace candidates arrive quoted with a trailing space, hence ${${(Q)word}% }.
zstyle ':fzf-tab:complete:cd:*' fzf-preview 'eza -1 --color=always $realpath'
zstyle ':fzf-tab:complete:git:*' fzf-preview \
  'case $words[2] in
     add|diff|restore) git diff -- ${${(Q)word}% } | delta ;;
     log) git log --color=always ${${(Q)word}% } ;;
   esac'
zstyle ':fzf-tab:complete:systemctl:*' fzf-preview \
  '(( $#words > 2 )) && SYSTEMD_COLORS=1 systemctl ${words[(r)--user]} status -- ${${(Q)word}% }'

#==============================================================================
# ⚡  Modular configuration
#==============================================================================

for zf in "$HOME/.zshrc.d/"*.zsh(N);      do source "$zf"; done
for zf in "$HOME/local/zshrc.d/"*.zsh(N); do source "$zf"; done

[[ -f $HOME/.aliases ]] && source $HOME/.aliases

# Load SSH key into agent on first interactive shell (graphical prompt via gcr)
if [[ -n "$DISPLAY" ]] && ! ssh-add -l >/dev/null 2>&1; then
  ssh-add 2>/dev/null
fi

#==============================================================================
# ⚡  Non-interactive shell configuration 
#==============================================================================

# Unplug zoxide in Non-interactive shells
if [[ $- != *i* ]]; then
    unfunction cd 2>/dev/null
    alias cd='builtin cd'
fi

